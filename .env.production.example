# ============================================================
#  Best Choice Online Shopping — Production .env (cPanel)
#  Copy this to .env and fill in every value marked <CHANGE>
# ============================================================

APP_NAME="Best Choice Online Shopping"
APP_ENV=production
APP_KEY=                            # <CHANGE> run: php artisan key:generate
APP_DEBUG=false                     # MUST be false in production
APP_URL=https://yourdomain.com      # <CHANGE> your actual domain with https

APP_LOCALE=bn
APP_FALLBACK_LOCALE=bn
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---- Logging ------------------------------------------------
LOG_CHANNEL=single
LOG_LEVEL=error                     # only errors, not debug noise

# ---- Database -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost                   # cPanel uses localhost
DB_PORT=3306
DB_DATABASE=cpanelusername_dbname   # <CHANGE> cPanel format: user_dbname
DB_USERNAME=cpanelusername_dbuser   # <CHANGE>
DB_PASSWORD=                        # <CHANGE>

# ---- Sessions & Cache (file drivers — no Redis needed) ------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

QUEUE_CONNECTION=sync               # cPanel has no queue worker; sync runs jobs inline

FILESYSTEM_DISK=public

# ---- Mail ---------------------------------------------------
MAIL_MAILER=smtp                    # <CHANGE> or use 'sendmail' for cPanel
MAIL_HOST=mail.yourdomain.com       # <CHANGE>
MAIL_PORT=465
MAIL_USERNAME=                      # <CHANGE>
MAIL_PASSWORD=                      # <CHANGE>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"  # <CHANGE>
MAIL_FROM_NAME="${APP_NAME}"

# ---- SSLCommerz (payment gateway) --------------------------
SSLCOMMERZ_STORE_ID=                # <CHANGE> get from sslcommerz.com
SSLCOMMERZ_STORE_PASSWORD=          # <CHANGE>
SSLCOMMERZ_SANDBOX=false            # false for live payments

# ---- Admin seeding (optional) ------------------------------
# DEMO_ADMIN_EMAIL=admin@yourdomain.com
# DEMO_ADMIN_PASSWORD=              # <CHANGE> strong password, 12+ chars

VITE_APP_NAME="${APP_NAME}"
